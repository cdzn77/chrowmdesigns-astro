import CaseInquiry from '../../components/CaseInquiry.astro';
import CasePrevNext from '../../components/CasePrevNext.astro';
import Footer from '../../components/Footer.astro';

const metadata = {
  title: 'Beat Saber Music Packs: UX Strategy & Art Direction',
