---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; label: string; heading: string; intro: string; }
const { title, description, label, heading, intro } = Astro.props;
const agency = Astro.url.pathname.includes("for-agencies");
---
<BaseLayout title={title} description={description} contentLabel={title}>
  <slot name="head" slot="head" />
  <article class="service-page">
    <header class="service-page__hero">
      <div class="service-page__title">
        <p class="service-page__eyebrow">{label}</p>
        <h1>{agency ? <>FOR<br />AGENCIES</> : <>DESIGN<br />SERVICES</>}</h1>
      </div>
      <div class="service-page__introduction">
        <p class="service-page__statement">{heading}</p>
        <p class="service-page__intro">{intro}</p>
        <a class="service-page__button" href="/contact/">Talk through your project <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <div class="service-page__body"><slot /></div>
  </article>
  <Footer slot="footer" />
</BaseLayout>
<style>
  /* Match the existing Cases and Info pages: Sequel headings, mono labels,
     split introductions, open project images, and full-width editorial bands. */
  .service-page { --service-gutter:clamp(20px,4.2vw,64px); background:#fff; color:#1b1b1b; font-family:var(--font-sans); }
  .service-page :global(*) { min-width:0; box-sizing:border-box; }
  .service-page :global(:is(h1,h2,h3,p)) { margin:0; }
  .service-page__hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,.75fr); align-items:end; gap:clamp(40px,8vw,120px); padding:64px var(--service-gutter) 60px; }
  .service-page__eyebrow { font:400 11px/1.5 'JetBrains Mono',monospace; letter-spacing:.04em; text-transform:uppercase; color:#666; margin-bottom:32px!important; }
  .service-page h1 { font:400 clamp(64px,9.2vw,140px)/.88 var(--font-sans); letter-spacing:-.065em; }
  .service-page__statement { font:400 clamp(24px,2.6vw,38px)/1.15 var(--font-sans); letter-spacing:-.035em; max-width:28ch; margin-bottom:24px!important; }
  .service-page__intro { font:400 clamp(16px,1.3vw,17px)/1.6 var(--font-sans); color:#555; max-width:65ch; }
  .service-page__button { display:inline-flex; align-items:center; gap:24px; min-height:44px; padding:14px 0; margin-top:24px; color:#1b1b1b; border-bottom:1px solid currentColor; text-decoration:none; font:400 12px/1.5 'JetBrains Mono',monospace; }
  .service-page :global(:is(a,summary):focus-visible) { outline:2px solid currentColor; outline-offset:5px; }
  .service-page :global(.service-section) { padding:56px var(--service-gutter); scroll-margin-top:110px; }
  .service-page :global(.service-section > h2) { border-top:1px solid #aaa; padding-top:18px; margin-bottom:40px; font:400 12px/1.5 'JetBrains Mono',monospace; text-transform:uppercase; letter-spacing:.04em; color:#666; }
  .service-page :global(h3) { font:400 clamp(25px,2.65vw,40px)/1.08 var(--font-sans); letter-spacing:-.035em; margin-bottom:24px; }
  .service-page :global(.service-section p),.service-page :global(li) { font:400 clamp(16px,1.3vw,17px)/1.6 var(--font-sans); color:#555; max-width:65ch; }
  .service-page :global(.service-section p + p) { margin-top:20px; }
  .service-page :global(.service-grid) { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:56px 48px; }
  .service-page :global(.service-section:first-child .service-grid) { counter-reset:service; }
  .service-page :global(.service-section:first-child .service-grid > div) { border-top:1px solid #ddd; padding-top:20px; }
  .service-page :global(.service-section:first-child .service-grid > div::before) { counter-increment:service; content:counter(service,decimal-leading-zero); display:block; font:400 11px/1.5 'JetBrains Mono',monospace; color:#666; margin-bottom:28px; }
  .service-page :global(.service-section a) { display:inline-flex; align-items:center; color:inherit; min-height:44px; padding:14px 0; margin-top:20px; font:400 12px/1.5 'JetBrains Mono',monospace; border-bottom:1px solid currentColor; text-decoration:none; }
  .service-page :global(.service-section a:hover),.service-page__button:hover { opacity:.7; }
  .service-page :global(.service-proof) { background:transparent; padding:0; }
  .service-page :global(.service-proof img) { display:block; width:100%; height:auto; aspect-ratio:16/10; object-fit:cover; margin-bottom:24px; }
  .service-page :global(.service-proof a.service-proof__image-link) { display:block; position:relative; overflow:hidden; width:100%; aspect-ratio:16/10; padding:0; margin:0 0 24px; border:0; opacity:1; }
  .service-page :global(.service-proof__image-link img) { height:100%; margin:0; transition:transform .4s ease; }
  .service-page :global(.service-proof__image-link:hover img), .service-page :global(.service-proof__image-link:focus-visible img) { transform:scale(1.05); }
  @media(prefers-reduced-motion:reduce) { .service-page :global(.service-proof__image-link img) { transition:none; } .service-page :global(.service-proof__image-link:hover img), .service-page :global(.service-proof__image-link:focus-visible img) { transform:none; } }
  .service-page :global(.service-proof p) { font:400 14px/1.6 'JetBrains Mono',monospace; }
  .service-page :global(.service-section > .service-grid:has(.service-proof)) { gap:64px 28px; margin-top:32px; }
  .service-page :global(ol) { counter-reset:step; list-style:none; padding:0; margin:0 0 0 31%; }
  .service-page :global(ol li) { position:relative; padding:24px 0 24px 52px; border-bottom:1px solid #ddd; max-width:none; }
  .service-page :global(ol li::before) { counter-increment:step; content:counter(step,decimal-leading-zero); position:absolute; left:0; top:28px; font:400 11px/1.5 'JetBrains Mono',monospace; color:#666; }
  .service-page :global(ol strong) { display:block; font:400 clamp(24px,2.2vw,32px)/1.2 var(--font-sans); letter-spacing:-.025em; color:#1b1b1b; margin-bottom:16px; }
  .service-page :global(details) { margin-left:31%; border-bottom:1px solid #ddd; padding:18px 0; }
  .service-page :global(summary) { font:400 clamp(20px,2vw,28px)/1.3 var(--font-sans); letter-spacing:-.025em; cursor:pointer; padding:8px 0; }
  .service-page :global(details p) { padding-top:16px; }
  .service-page :global(.service-section:last-child) { background:#1b1b1b; color:#fff; padding-block:64px; display:grid; grid-template-columns:minmax(0,.7fr) minmax(0,1fr); column-gap:clamp(32px,7vw,100px); }
  .service-page :global(.service-section:last-child > h2) { grid-column:1; grid-row:1/5; font:400 clamp(30px,3.5vw,50px)/1.08 var(--font-sans); letter-spacing:-.04em; text-transform:none; border:0; padding:0; color:#fff; margin:0; }
  .service-page :global(.service-section:last-child > :not(h2)) { grid-column:2; }
  .service-page :global(.service-section:last-child p) { color:#bbb; }
  .service-page :global(.service-section:last-child a) { justify-self:start; }
  .service-page :global(.service-section:last-child br) { display:none; }
  @media(max-width:800px) { .service-page__hero { grid-template-columns:1fr; padding-block:40px; gap:32px; } .service-page h1 { font-size:clamp(54px,9vw,90px); } .service-page :global(.service-grid) { gap:40px 24px; } .service-page :global(ol),.service-page :global(details) { margin-left:0; } }
  @media(max-width:600px) { .service-page__hero { grid-template-columns:1fr; padding-block:36px; gap:32px; } .service-page h1 { font-size:clamp(54px,15vw,90px); } .service-page__eyebrow { margin-bottom:24px!important; } .service-page :global(.service-grid) { grid-template-columns:1fr; gap:40px; } .service-page :global(.service-section) { padding-block:36px; } .service-page :global(.service-section:last-child) { display:block; padding-block:48px; } .service-page :global(.service-section:last-child > h2) { margin-bottom:28px; } .service-page :global(.service-section:last-child a) { display:table; } }

@media(max-width:800px){.service-page :global(.service-proof p){font-size:16px}}

</style>
