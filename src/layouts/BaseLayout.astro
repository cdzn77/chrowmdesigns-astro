---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import BackToTop from '../components/BackToTop.astro';
import ClientRouter from 'astro/components/ClientRouter.astro';
import { SITE_URL, normalizePath, canonicalFor, caseForPath, isIndexable, structuredData } from '../lib/site-seo';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalURL?: string;
}

const {
  title,
  description = 'Angelo Manzano Jr. — Senior Product Designer with 20 years of experience crafting digital experiences that connect, engage, and inspire.',
  ogImage,
  ogType = 'website',
  canonicalURL: requestedCanonical,
} = Astro.props;

const siteName = 'ChrowmDesigns';
const path = normalizePath(Astro.url.pathname);
const fullTitle = title === siteName ? `Angelo Manzano Jr. — Senior UX Strategist | ${siteName}` : `${title} — ${siteName}`;
const canonicalURL = canonicalFor(new URL(requestedCanonical ?? path, SITE_URL).pathname);
const indexable = isIndexable(path);
const project = caseForPath(path);
const socialImage = new URL(ogImage ?? project?.thumbnail ?? '/hero-poster.jpg', SITE_URL).href;
const socialImageAlt = project ? `${project.title} — ChrowmDesigns portfolio` : 'Selected design work from ChrowmDesigns';
const schema = structuredData(path, fullTitle, description, socialImage);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Discover page-specific hero preloads before font downloads. -->
    <slot name="head" />

    <!-- First-paint typography is hosted with the site. -->
    <link rel="preload" href="/fonts/optimized/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/optimized/jetbrainsmono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="preload" href="/fonts/optimized/sequel-sans-roman.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=chrowm-1" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=chrowm-1" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=chrowm-1" sizes="180x180" />

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {indexable && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- View Transitions (Astro client-side router) -->
    <ClientRouter />

    <!-- Skip to content (accessibility) -->
    <!-- rendered as inline style to avoid FOUC -->
    <style>
      #skip-to-content {
        position: absolute;
        top: -100%;
        left: 1rem;
        background: #1b1b1b;
        color: #ffffff;
        padding: 0.5rem 1rem;
        font-weight: 600;
        z-index: 9999;
        border-radius: 0 0 4px 4px;
        transition: top 0.2s;
      }
      #skip-to-content:focus {
        top: 0;
      }
    </style>
  </head>

  <body>
    <!-- Accessibility: skip nav -->
    <a id="skip-to-content" href="#main-content">Skip to content</a>

    <Nav />

    <main id="main-content" tabindex="-1" aria-label={title}>
      <slot />
    </main>

    <slot name="footer" />

    <BackToTop />
  </body>
</html>
