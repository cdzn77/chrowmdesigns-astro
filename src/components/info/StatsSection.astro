---
const stats = [
 {value:'20+',label:'YEARS OF PRACTICE'},
 {value:'60M',label:'IMPRESSIONS DELIVERED'},
 {value:'300%',label:'ENGAGEMENT LIFT'},
 {value:'44%',label:'AVG EXIT RATE REDUCTION'},
 {value:'8+',label:'ENTERPRISE CLIENTS'},
];
---
<section id="stats-section" aria-label="Studio results">
 <dl id="stats-grid">{stats.map(stat=><div class="proof-stat"><dt>{stat.label}</dt><dd>{stat.value}</dd><span aria-hidden="true" class="proof-stat__corners"></span></div>)}</dl>
</section>
<style>
 #stats-section{padding:clamp(100px,15vw,140px) clamp(16px,5vw,60px) clamp(100px,15vw,160px);background:#1b1b1b;color:#fff;width:100%}
 #stats-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:2.4rem 2rem;margin:0}
 .proof-stat{position:relative;padding:2.5rem;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;gap:24px;min-width:0;border:1px solid #b0b0b0;min-height:220px}
 .proof-stat:nth-child(1){grid-column:span 3;min-height:clamp(300px,32vw,380px)}
 .proof-stat:nth-child(2){grid-column:span 2}
 .proof-stat:nth-child(3){grid-column:6;grid-row:1/span 2}
 .proof-stat:nth-child(4){grid-column:span 2}
 .proof-stat:nth-child(5){grid-column:span 3}
 .proof-stat dt{order:2;color:#aaa;font:12px/1.4 'JetBrains Mono',monospace;letter-spacing:.5px;overflow-wrap:anywhere}
 .proof-stat dd{order:1;margin:0;font:300 clamp(40px,6vw,110px)/1.05 Manrope,sans-serif;letter-spacing:-.06em;overflow-wrap:anywhere;max-width:100%}
 .proof-stat:nth-child(3) dd{font-size:clamp(30px,4vw,60px)}
 .proof-stat__corners{position:absolute;inset:-1px;pointer-events:none;background:linear-gradient(#fff,#fff) left top/8px 8px,linear-gradient(#fff,#fff) right top/8px 8px,linear-gradient(#fff,#fff) left bottom/8px 8px,linear-gradient(#fff,#fff) right bottom/8px 8px;background-repeat:no-repeat}
 @media(max-width:1023px){#stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.proof-stat:nth-child(n){grid-column:auto;grid-row:auto;min-height:220px;padding:24px}.proof-stat:nth-child(1),.proof-stat:nth-child(5){grid-column:1/-1}.proof-stat:nth-child(n) dd{font-size:clamp(40px,9vw,80px)}}
 @media(max-width:480px){#stats-grid{grid-template-columns:minmax(0,1fr)}.proof-stat:nth-child(n){grid-column:auto;min-height:180px}.proof-stat:nth-child(n) dd{font-size:clamp(40px,14vw,64px)}}
</style>
