---
const phases = [
      {
        title: 'INSIGHT DISCOVERY',
        items: [
          'USER RESEARCH & INTERVIEWS',
          'USABILITY TESTING',
          'STAKEHOLDER ALIGNMENT',
          'COMPETITIVE ANALYSIS',
          'INSIGHT SYNTHESIS',
          'JOURNEY MAPPING'
        ]
      },
      {
        title: 'CONCEPT DEVELOPMENT',
        items: [
          'INFORMATION ARCHITECTURE',
          'USER FLOW MAPPING',
          'WIREFRAMING & PROTOTYPING',
          'DESIGN SYSTEM PLANNING',
          'INTERACTION STRATEGY',
          'CONCEPT VALIDATION'
        ]
      },
      {
        title: 'DESIGN EXECUTION',
        items: [
          'HIGH-FIDELITY DESIGN',
          'RESPONSIVE IMPLEMENTATION',
          'DESIGN SYSTEM DOCUMENTATION',
          'DEVELOPER HANDOFF',
          'QUALITY ASSURANCE',
          'POST-LAUNCH OPTIMIZATION'
        ]
      }
    ];
---

<section class="approach-section">
  <div class="approach-layout">
    <div>
      <h2>/APPROACH</h2>
      <p class="approach-intro">WE DESIGN FOR THE PROBLEM,<br />NOT THE PORTFOLIO.</p>
      <div class="approach-phases">
        {phases.map((phase, index) => (
          <details name="studio-approach" open={index === 0}>
            <summary>
              <span>{phase.title}</span>
              <span class="accordion-icon" aria-hidden="true"></span>
            </summary>
            <p>{phase.items.map(item => item.charAt(0).toUpperCase() + item.slice(1).toLowerCase()).join(', ')}</p>
          </details>
        ))}
      </div>
    </div>
    <div class="approach-image">
      <img src="https://cdzn2026stg.wpenginepowered.com/wp-content/uploads/2026/05/bio_approach.webp" alt="Approach" width="600" height="600" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .approach-section { padding: 160px clamp(16px, 5vw, 60px); background: #fff; }
  .approach-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(60px, 10vw, 100px); align-items: start; padding-left: 40px; padding-right: clamp(16px, 5vw, 60px); }
  .approach-layout > * { min-width: 0; }
  h2 { font: 400 12px 'JetBrains Mono', monospace; color: #666; margin: 0 0 60px; letter-spacing: .5px; }
  .approach-intro { font: 400 24px/1.3 Manrope, sans-serif; color: #1b1b1b; margin: 0 0 120px; max-width: 500px; }
  .approach-phases { max-width: 547px; }
  details + details { border-top: 1px solid #ddd; margin-top: 16px; padding-top: 16px; }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 20px; min-height: 44px; color: #1b1b1b; font: 400 12px/1.5 'JetBrains Mono', monospace; letter-spacing: .5px; cursor: pointer; list-style: none; overflow-wrap: anywhere; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid #1b1b1b; outline-offset: 5px; }
  .accordion-icon { flex-shrink: 0; font: 100 32px/1 system-ui; }
  .accordion-icon::before { content: '+'; }
  details[open] .accordion-icon::before { content: '−'; }
  details p { margin: 12px 0 16px; color: #666; font: 400 12px/1.6 'JetBrains Mono', monospace; letter-spacing: .3px; text-transform: uppercase; }
  .approach-image { display: flex; justify-content: center; }
  img { display: block; width: 100%; max-width: 600px; height: auto; aspect-ratio: 1; object-fit: cover; background: #1b1b1b; }
  @media (max-width: 800px) {
    .approach-section { padding-block: 80px; }
    .approach-layout { grid-template-columns: minmax(0, 1fr); padding-inline: 0; gap: 48px; }
    .approach-intro { margin-bottom: 60px; }
  }
</style>
