<section id="analytics-consent" class="analytics-notice" aria-labelledby="analytics-notice-title" hidden>
  <h2 id="analytics-notice-title">Analytics, your choice.</h2>
  <p>With your permission, I use Google Analytics to understand which pages people visit and whether inquiries are sent. No advertising tracking. Your form details aren’t sent to Analytics.</p>
  <div class="analytics-notice__actions">
    <button type="button" data-analytics-choice="accepted">Allow analytics</button>
    <button type="button" data-analytics-choice="declined">No thanks</button>
  </div>
  <p class="analytics-notice__note">Change your choice anytime in the footer. <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">How Google uses data<span class="visually-hidden"> (opens in a new tab)</span></a></p>
</section>

<script>
  import '../scripts/analytics';
</script>

<style>
  .analytics-notice[hidden]{display:none}
  .analytics-notice{position:fixed;z-index:9998;bottom:20px;left:20px;width:min(420px,calc(100% - 40px));max-height:calc(100dvh - 120px);overflow:auto;background:#fff;color:#1b1b1b;border:1px solid #b7b7b7;padding:22px;box-shadow:0 8px 28px rgb(27 27 27 / .12)}
  .analytics-notice h2{font:600 19px/1.3 'Manrope',sans-serif;letter-spacing:-.02em;margin:0 0 10px}
  .analytics-notice p{font:400 13px/1.6 'JetBrains Mono',monospace;margin:0}
  .analytics-notice__actions{display:flex;gap:10px;margin:16px 0 12px;flex-wrap:wrap}
  .analytics-notice button{flex:1;min-width:130px;min-height:44px;border:1px solid #1b1b1b;background:#fff;color:#1b1b1b;font:500 13px/1.4 'Manrope',sans-serif;padding:10px 12px;cursor:pointer}
  .analytics-notice button:hover{background:#ededed}
