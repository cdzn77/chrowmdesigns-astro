---
// Hero renders a full-viewport video background matching React ChrowmDesigns design exactly.
// Charcoal background with video overlay, white text, structured layout with dark stat cards.
---

<section class="hero">
  <!-- Background Video -->
  <div class="hero__video-wrap" aria-hidden="true">
    <video
      class="hero__video"
      data-hero-video
      poster="/images/responsive/hero-poster.webp"
      muted
      loop
      playsinline
      preload="none"
    >
      <source src="/video/hero-mobile.mp4" media="(max-width: 768px)" type="video/mp4" />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Main Content -->
  <div class="hero__content">
    <!-- Top Section: Info columns -->
    <div class="hero__top-section">
      <div class="hero__info-left">
        <p class="hero__label">Senior UX<br />Strategist</p>
        <p class="hero__tagline">20 years designing<br />digital products that<br />inspire users</p>
      </div>

      <div class="hero__info-right">
        <p class="hero__description">
          Design that performs. Gaming, hospitality, entertainment, and CPG brands trust ChrowmDesigns to deliver digital experiences that move the numbers.
        </p>

      </div>
    </div>

    <!-- Bottom Section: Headline + CTA + Stats -->
    <div class="hero__bottom-section">
      <!-- Left: Headline + CTA -->
      <div class="hero__cta-block">
        <h1 class="hero__heading">designed to<br />connect</h1>
        <p class="hero__sub">UX strategy and digital design<br />for brands ready to move forward.</p>
        <div class="hero__actions"><a class="hero__cta" href="/contact">let's talk design</a><a class="hero__work" href="/cases">Explore the work <span aria-hidden="true">↗</span></a></div>
      </div>

      <!-- Right: Stat Cards -->
      <div class="hero__stats">
        <div class="hero__stat-card">
          <p class="hero__stat-value">20+</p>
          <p class="hero__stat-label">Years<br />experience</p>
        </div>
        <div class="hero__stat-card">
          <p class="hero__stat-value">6</p>
          <p class="hero__stat-label">Featured<br />projects</p>
        </div>
      </div>
    </div>
  </div>
  <button class="hero__motion" type="button" data-hero-motion data-paused="true" aria-label="Play background video" title="Play background video" hidden>
    <svg class="hero__motion-play" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 2.5v11L13 8z" /></svg>
    <svg class="hero__motion-pause" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 3h3v10H4zm5 0h3v10H9z" /></svg>
  </button>
</section>

<style>
  /* Root container - charcoal background with video */
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-color: #1b1b1b;
    overflow: hidden;
  }

  /* Background Video */
  .hero__video-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Main Content */
  .hero__content {
    position: relative;
    z-index: 20;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding: clamp(16px, 4vw, 32px);
    padding-top: clamp(80px, 15vw, 120px);
  }

  /* Top Section: Info columns */
  .hero__top-section {
    display: flex;
    justify-content: space-between;
    gap: clamp(16px, 5vw, 32px);
    margin-bottom: 32px;
    flex: 1;
    align-items: flex-start;
  }

  .hero__info-left {
    max-width: clamp(200px, 40vw, 260px);
  }

  .hero__label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    line-height: 1.3;
    margin-bottom: 8px;
    color: white;
    margin: 0 0 8px 0;
    font-family: 'JetBrains Mono', monospace;
  }

  .hero__tagline {
    font-size: 12px;
    line-height: 1.5;
    opacity: 0.8;
    color: white;
    margin: 0;
    font-weight: 400;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
  }

  .hero__info-right {
    max-width: clamp(200px, 40vw, 320px);
  }

  .hero__description {
    font-size: 12px;
    line-height: 1.6;
    margin-bottom: 12px;
    color: white;
    margin: 0;
    font-weight: 400;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
  }

  .hero__keywords {
    font-size: 12px;
    line-height: 1.7;
    opacity: 0.7;
    color: white;
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
  }

  /* Bottom Section: Headline + CTA + Stats */
  .hero__bottom-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }

  .hero__cta-block {
    flex: 1;
  }

  .hero__heading {
    font-family: 'Geist', sans-serif;
    font-weight: 400;
    font-size: clamp(56px, 13vw, 175px);
    letter-spacing: -0.04em;
    line-height: 0.78;
    color: white;
    margin: 0 0 24px 0;
    width: fit-content;
    text-transform: none;
  }

  .hero__sub {
    font-size: 12px;
    line-height: 1.5;
    color: white;
    margin-bottom: 16px;
    margin: 0 0 16px 0;
    font-weight: 400;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
  }

  .hero__cta {
    display: inline-block;
    background-color: #1b1b1b;
    color: white;
    border: none;
    border-radius: 0;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    font-size: 12px;
    padding: clamp(12px, 3vw, 16px) clamp(24px, 8vw, 48px);
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(27, 27, 27, 0.1);
    transition: background-color 0.2s;
    text-decoration: none;
    text-transform: uppercase;
    min-width: 44px;
    min-height: 44px;
  }

  .hero__cta:hover {
    background-color: #333333;
  }

  /* Stat Cards: Dark semi-transparent design */
  .hero__stats {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
    flex-wrap: nowrap;
    overflow: auto;
  }

  .hero__stat-card {
    width: 150px;
    height: 150px;
    padding: 20px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(27, 27, 27, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.15);
    text-align: left;
    transition: transform 0.3s;
    cursor: default;
    box-shadow: 0 8px 32px rgba(27, 27, 27, 0.1);
    flex-shrink: 0;
  }

  .hero__stat-card:hover {
    transform: translateY(-4px);
  }

  .hero__stat-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #ffffff;
    line-height: 1;
    margin: 0;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hero__stat-label {
    font-size: 12px;
    color: #cccccc;
    margin: 0;
    margin-top: auto;
    white-space: pre-line;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero__content {
      padding: clamp(16px, 4vw, 32px);
      padding-top: clamp(80px, 15vw, 120px);
    }

    .hero__top-section {
      flex-direction: column;
      gap: clamp(16px, 5vw, 32px);
      margin-bottom: 32px;
    }

    .hero__bottom-section {
      flex-direction: column;
      gap: 32px;
    }

    .hero__stats {
      width: 100%;
      overflow-x: auto;
    }

    .hero__stat-card {
      flex-shrink: 0;
    }
  }
  .hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 24px; }
  .hero__work { color: var(--color-white); text-underline-offset: 5px; padding: 12px 0; font-size: var(--font-size-md); }
  .hero__motion { position: absolute; top: 16px; right: 24px; z-index: 21; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--color-white); cursor: pointer; }
  .hero__motion::before { content: ''; position: absolute; inset: 6px; border: 1px solid rgba(255,255,255,.35); border-radius: 50%; background: rgba(27, 27, 27,.28); }
  .hero__motion:hover::before, .hero__motion:focus-visible::before { background: rgba(27, 27, 27,.6); border-color: rgba(255,255,255,.8); }
  .hero__motion svg { position: relative; grid-area: 1 / 1; }
  .hero__motion[data-paused="true"] .hero__motion-pause,
  .hero__motion[data-paused="false"] .hero__motion-play { display: none; }
  .hero__motion[hidden] { display: none; }
  .hero :is(a, button):focus-visible { outline: 2px solid var(--color-white); outline-offset: 5px; }
  @media (max-width: 768px) {
    .hero, .hero__content { min-height: calc(100svh - 76px); }
    .hero__content { padding-top: 84px; gap: 40px; }
    .hero__top-section { flex: 0; margin-bottom: 0; }
    .hero__info-right { display: none; }
    .hero__bottom-section { align-items: stretch; gap: 28px; }
    .hero__heading { font-size: clamp(56px, 15vw, 110px); line-height: .92; }
    .hero__sub { font-family: var(--font-sans); font-size: var(--font-size-md); text-transform: none; max-width: 30ch; }
    .hero__stats { overflow: visible; gap: 12px; }
    .hero__stat-card { width: auto; flex: 1; height: 100px; padding: 16px; }
    .hero__stat-value { font-size: var(--font-size-lg); }
    .hero__motion { right: 16px; }
  }

.hero__video-wrap::after{content:"";position:absolute;inset:0;background:rgba(27, 27, 27,.64)}
.hero__tagline,.hero__keywords{opacity:1}
.hero__stat-card{min-height:100px;height:auto}
.hero__content{overflow-wrap:anywhere}

</style>
<script>
  let cleanupHero: (() => void) | undefined;
  function initHero() {
    cleanupHero?.();
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    const button = document.querySelector<HTMLButtonElement>('[data-hero-motion]');
    if (!video || !button) return;
    const controller = new AbortController();
    const { signal } = controller;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const update = () => {
      const label = video.paused ? 'Play background video' : 'Pause background video';
      button.setAttribute('aria-label', label);
      button.title = label;
      button.dataset.paused = String(video.paused);
    };
    const play = () => { video.play().catch(update); };
    button.hidden = false;
    video.addEventListener('play', update, { signal });
    video.addEventListener('pause', update, { signal });
    button.addEventListener('click', () => { if (video.paused) play(); else video.pause(); }, { signal });
    reduced.addEventListener('change', () => { if (reduced.matches) video.pause(); }, { signal });
    if (!reduced.matches) play();
    update();
    cleanupHero = () => { controller.abort(); video.pause(); };
  }
  document.addEventListener('astro:page-load', initHero);
  document.addEventListener('astro:before-swap', () => cleanupHero?.());
</script>
