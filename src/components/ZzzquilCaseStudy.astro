ing:145px 4vw}.palette__head{display:grid;grid-template-columns:1fr 1.3fr;gap:8vw}.palette>.copy{margin:80px 0 70px 42%;max-width:820px}.palette__images{display:grid;grid-template-columns:.4fr .4fr .4fr;gap:20px;align-items:end;margin-left:18%;max-width:970px}.palette__images figure:nth-child(2){margin-bottom:85px}.palette__images img{aspect-ratio:.72}.platform{display:grid;grid-template-columns:1fr 1.3fr;gap:8vw}.platform>figure{grid-column:1/-1;margin-top:55px}.platform>figure img{aspect-ratio:1.78}.platform>.copy{grid-column:2}.results{background:#ece6ff;color:#1c113d;padding:140px 4vw}.results>div:first-child{display:grid;grid-template-columns:1fr 1.3fr;gap:8vw}.results>div>p{color:#5c3cb0}.numbers{border-top:1px solid rgba(28,17,61,.28);display:grid;grid-template-columns:repeat(3,1fr);margin-top:90px}.numbers div{border-right:1px solid rgba(28,17,61,.28);padding:20px 20px 42px 0}.numbers div+div{padding-left:20px}.numbers div:last-child{border:0}.numbers b{display:block;font-size:clamp(60px,8vw,130px);font-weight:500;letter-spacing:-.1em;line-height:.8}.numbers span{display:block;font-size:13px;line-height:1.3;margin-top:23px;max-width:135px}.results>.copy{margin:105px 0 0 42%;max-width:820px}.results .copy p:last-child{color:#554879}@media(max-width:800px){.zzz header{padding-bottom:54px}.meta{grid-template-columns:1fr auto}.meta span:last-child{display:none}.intro,.research,.palette__head,.platform,.results>div:first-child{grid-template-columns:1fr;gap:34px}.intro{padding-top:50px}.intro h1{font-size:clamp(65px,21vw,125px)}.hero{height:52vw;min-height:280px}.research,.palette,.platform,.results{padding-top:84px;padding-bottom:84px}.copy{grid-template-columns:1fr}.research__images{grid-template-columns:1fr 1fr;margin-top:20px}.research__images figure:last-child{grid-column:span 2}.research__images figure:nth-child(2){margin-bottom:0}.palette>.copy,.results>.copy{margin:55px 0}.palette__images{margin:0;grid-template-columns:1fr 1fr}.palette__images figure:nth-child(2){margin-bottom:0}.palette__images figure:last-child{grid-column:span 2}.platform>figure{margin-top:20px}.platform>.copy{grid-column:auto}.numbers{grid-template-columns:1fr;margin-top:54px}.numbers div,.numbers div+div{border-bottom:1px solid rgba(28,17,61,.28);border-right:0;padding:20px 0 30px}}.palette__head>p{color:#d5c5ff}

