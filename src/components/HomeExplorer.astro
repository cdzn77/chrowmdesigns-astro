---
import CaseCard from './CaseCard.astro';
import HireMarquee from './HireMarquee.astro';
import cases from '../data/cases.json';
const { variant } = Astro.props;
const featuredCases = cases.slice(0, 6);
const skills = [
  ['001','Strategic Approach','I align design with your brand, audience, and business goals to create strategic, user-focused digital experiences that deliver measurable results.'],
  ['002','User Experience','Delivering excellent user experiences is essential for building trust and is central to my approach, which focuses on intuitive functionality, simplicity, and delight.'],
  ['003','Interactive Design','Design is central to my work, where I combine creativity and expertise to achieve outstanding results.'],
  ['004','Digital Experiences','I design end-to-end product journeys that balance usability, emotional impact, and brand expression across web and digital platforms.'],
];
const labels = { editorial:'Option 01 — Editorial portfolio', index:'Option 02 — Work index', manifesto:'Option 03 — Manifesto', atlas:'Option 04 — Capability atlas' };
---
<div class:list={['explorer', `explorer--${variant}`]}>
  <div class="chooser"><span>{labels[variant]}</span><nav aria-label="Homepage exploration options"><a href="/home-explorations/editorial/">01</a><a href="/home-explorations/index/">02</a><a href="/home-explorations/manifesto/">03</a><a href="/home-explorations/atlas/">04</a></nav></div>
  {variant === 'editorial' && <>
    <section class="opening opening--editorial"><p class="eyebrow">Selected work / 2018—2022</p><h2>Crafting digital experiences that connect, engage and inspire.</h2><p class="opening__note">Florida-based, freelance, multidisciplinary designer studio</p></section>
    <section class="work work--editorial">{featuredCases.map((c,i)=><article class:list={['work__item', i===0 && 'work__item--feature']}><CaseCard title={c.title} category={c.category} thumbnail={c.thumbnail} href={c.url} description={c.description} loading={i<2?'eager':'lazy'} /></article>)}</section>
    <section class="statement"><p>[CD® — 02]</p><h2>ChrowmDesigns is an independent UX consultancy built on one principle: design that performs.</h2><p>Twenty years of work across gaming, hospitality, entertainment, and CPG means the studio has seen what separates a good-looking product from one that actually moves the numbers.</p></section>
  </>}
  {variant === 'index' && <>
    <section class="opening opening--index"><div><p class="eyebrow">Project Focus</p><h2>Work that holds up.</h2></div><p>I work with brands, product teams, and platforms that need design to do more than look good. Every project starts with the problem, not the pixels.</p></section>
    <section class="work work--index">{featuredCases.map((c,i)=><article class="index-row"><span>0{i+1}</span><CaseCard title={c.title} category={c.category} thumbnail={c.thumbnail} href={c.url} description={c.description} loading={i<2?'eager':'lazy'} /></article>)}</section>
    <section class="approach"><p class="eyebrow">Approach</p><p>From first conversation to final delivery, the work stays grounded in real user behavior, business context, and decisions that hold up. Every experience ships with purpose and a reason behind each choice.</p></section>
  </>}
  {variant === 'manifesto' && <>
    <section class="opening opening--manifesto"><p class="eyebrow">[CDN = 01]</p><h2>Design that performs.</h2><p>Crafting digital experiences that connect, engage and inspire.</p></section>
    <section class="manifesto-copy"><p>ChrowmDesigns sits at the intersection of strategy and craft. The work isn't about aesthetics for their own sake. It's about understanding what a business needs to communicate, who needs to hear it, and building the experience that closes that gap. That's what the last 20 years have been about.</p><img src="/images/editorial-center.webp" alt="ChrowmDesigns" loading="lazy" /><p>Awards are a byproduct, not a benchmark. The real measure is whether the work actually moved something. A conversion rate, a user's confidence, a brand's clarity in a crowded market. That's the part worth chasing.</p></section>
    <section class="work work--manifesto">{featuredCases.map((c,i)=><article><CaseCard title={c.title} category={c.category} thumbnail={c.thumbnail} href={c.url} description={c.description} loading={i<2?'eager':'lazy'} /></article>)}</section>
  </>}
  {variant === 'atlas' && <>
    <section class="opening opening--atlas"><p class="eyebrow">Capabilities / selected work</p><h2>Strategy and craft, built to move the numbers.</h2><p>Building thoughtful, enduring brands through design and intention.</p></section>
    <section class="skills-grid">{skills.map(([number,title,description])=><article><span>{number}</span><h2>{title}</h2><p>{description}</p></article>)}</section>
    <section class="work work--atlas">{featuredCases.map((c,i)=><article><CaseCard title={c.title} category={c.category} thumbnail={c.thumbnail} href={c.url} description={c.description} loading={i<2?'eager':'lazy'} /></article>)}</section>
  </>}
  <HireMarquee />
</div>
<style>
 .explorer{--ink:#1b1b1b;--paper:#f6f4ee;--muted:#5c6363;--line:#c7cbc8;background:var(--paper);color:var(--ink);font-family:Manrope,Arial,sans-serif}.explorer *{box-sizing:border-box}.chooser{align-items:center;background:#1b1b1b;color:#fff;display:flex;font-size:11px;justify-content:space-between;letter-spacing:.09em;padding:18px 4vw;text-transform:uppercase}.chooser nav{display:flex;gap:18px}.chooser a{color:#9da5a4;text-decoration:none}.chooser a:hover{color:#70d4c4}.eyebrow{color:#3d625c;font-size:12px;letter-spacing:.08em;text-transform:uppercase}.opening{min-height:58vh;padding:clamp(80px,12vw,180px) 4vw 8vw}.opening h2{font-size:clamp(56px,10vw,164px);font-weight:500;letter-spacing:-.09em;line-height:.8;margin:25px 0}.opening>p:not(.eyebrow){font-size:clamp(18px,2vw,28px);line-height:1.3;max-width:590px}.opening--editorial h2{max-width:1200px}.opening__note{color:var(--muted);margin:90px 0 0}.work{padding:0 4vw 150px}.work :global(.case-card){height:100%}.work--editorial{display:grid;gap:20px;grid-template-columns:repeat(3,1fr)}.work--editorial .work__item--feature{grid-column:span 2;grid-row:span 2}.statement{border-top:1px solid var(--line);display:grid;gap:30px;grid-template-columns:.35fr 1.1fr .7fr;padding:140px 4vw}.statement p{color:var(--muted);font-size:17px;line-height:1.5;margin:0}.statement h2{font-size:clamp(34px,4.2vw,66px);font-weight:500;letter-spacing:-.065em;line-height:.94;margin:0}.opening--index{align-items:end;display:grid;grid-template-columns:1.2fr .55fr;gap:8vw}.opening--index h2{margin-bottom:0}.index-row{align-items:center;border-top:1px solid var(--line);display:grid;gap:30px;grid-template-columns:60px 1fr;padding:22px 0}.index-row>span{color:#3d625c;font-size:12px}.index-row :global(.case-card){display:grid;grid-template-columns:.65fr 1fr;gap:40px}.approach{background:#dbe7e2;display:grid;gap:8vw;grid-template-columns:.35fr 1fr;padding:140px 25% 140px 4vw}.approach p:last-child{font-size:clamp(26px,3vw,46px);letter-spacing:-.055em;line-height:1.04;margin:0}.opening--manifesto{background:#1b1b1b;color:#eef4f1;min-height:67vh}.opening--manifesto .eyebrow{color:#78cdbf}.manifesto-copy{align-items:center;display:grid;gap:7vw;grid-template-columns:1fr .85fr 1fr;padding:140px 4vw}.manifesto-copy p{font-size:clamp(18px,1.8vw,27px);letter-spacing:-.035em;line-height:1.35;margin:0}.manifesto-copy img{aspect-ratio:.9;object-fit:cover;width:100%}.work--manifesto{display:grid;gap:20px;grid-template-columns:repeat(2,1fr)}.work--manifesto article:nth-child(3n){grid-column:span 2}.opening--atlas{background:#dbe7e2}.skills-grid{display:grid;grid-template-columns:repeat(4,1fr);padding:0 4vw 140px}.skills-grid article{border-top:1px solid var(--line);min-height:370px;padding:18px 20px 30px 0}.skills-grid article+article{padding-left:20px;border-left:1px solid var(--line)}.skills-grid span{color:#3d625c;font-size:12px}.skills-grid h2{font-size:30px;font-weight:500;letter-spacing:-.05em;margin:82px 0 15px}.skills-grid p{color:var(--muted);font-size:15px;line-height:1.45}.work--atlas{background:#1b1b1b;display:grid;gap:20px;grid-template-columns:repeat(3,1fr);padding-top:120px}.work--atlas article:first-child{grid-column:span 2}@media(max-width:760px){.opening,.opening--index,.statement,.manifesto-copy,.approach{display:block;min-height:auto}.opening{padding-top:100px}.opening h2{font-size:clamp(52px,17vw,100px)}.opening--index>p{margin-top:35px}.work--editorial,.work--manifesto,.work--atlas{grid-template-columns:1fr}.work--editorial .work__item--feature,.work--manifesto article:nth-child(3n),.work--atlas article:first-child{grid-column:auto;grid-row:auto}.statement>*+*,.manifesto-copy>*+*,.approach>*+*{margin-top:30px}.index-row{grid-template-columns:30px 1fr}.index-row :global(.case-card){display:block}.skills-grid{grid-template-columns:1fr 1fr}.skills-grid article{min-height:280px}.skills-grid article:nth-child(3){border-left:0;padding-left:0}.chooser{gap:15px}.chooser nav{gap:10px}}
.explorer :global(*){min-width:0}.chooser a{min-width:32px;min-height:44px;display:inline-flex;align-items:center;justify-content:center}.explorer h2{overflow-wrap:anywhere}@media(max-width:480px){.skills-grid{grid-template-columns:1fr}.skills-grid article+article{border-left:0;padding-left:0}}
.chooser{flex-wrap:wrap}.chooser nav{flex-wrap:wrap}
</style>
