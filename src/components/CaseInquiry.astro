---
interface Props { project: string; }
const { project } = Astro.props;
---
<section class="case-inquiry" aria-label="Discuss a similar project">
  <div>
    <p class="case-inquiry__label">/YOUR NEXT PROJECT</p>
    <h2>Working on<br />something similar?</h2>
  </div>
  <div class="case-inquiry__details">
    <p>If the {project} work connects with a challenge your team is facing, tell me what you have in mind. We can discuss the scope and where I can help.</p>
    <a href="/contact/">Discuss a similar project <span aria-hidden="true">↗</span></a>
    <a href="/for-agencies/">Explore agency contract support <span aria-hidden="true">↗</span></a>
  </div>
</section>
<style>
.case-inquiry{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.75fr);gap:clamp(32px,8vw,120px);padding:64px clamp(20px,4.2vw,64px);background:#f5f5f5;color:#1b1b1b;font-family:var(--font-sans)}
.case-inquiry__label{font:400 11px/1.5 'JetBrains Mono',monospace;color:#666;letter-spacing:.04em;margin:0 0 24px}
.case-inquiry h2{font:400 clamp(32px,4vw,58px)/1.08 var(--font-sans);letter-spacing:-.04em;margin:0}
.case-inquiry__details p{font:400 clamp(16px,1.3vw,17px)/1.6 var(--font-sans);color:#555;margin:0 0 20px;max-width:60ch}
.case-inquiry a{display:table;min-height:44px;padding:14px 0;margin-top:8px;border-bottom:1px solid currentColor;color:inherit;text-decoration:none;font:400 12px/1.5 'JetBrains Mono',monospace}
.case-inquiry a span{margin-left:16px}.case-inquiry a:hover{opacity:.7}.case-inquiry a:focus-visible{outline:2px solid currentColor;outline-offset:5px}
@media(max-width:700px){.case-inquiry{grid-template-columns:1fr;padding-block:40px;gap:28px}}
</style>
