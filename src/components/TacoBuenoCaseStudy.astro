margin-top:90px}.proof__art img{aspect-ratio:.72}.proof__art figure:last-child img{aspect-ratio:1.78}.digital{display:grid;grid-template-columns:1fr 1.3fr;gap:8vw}.digital>figure:not(.shellfies){grid-column:1/-1;margin-top:55px}.digital>figure:not(.shellfies) img{aspect-ratio:1.78}.digital>.copy{grid-column:2;margin-top:15px}.shellfies{grid-column:1/-1;margin-top:55px}.shellfies img{aspect-ratio:1.78}.results{background:var(--red);color:#fff;padding:140px 4vw}.results>div:first-child{display:grid;grid-template-columns:1fr 1.3fr;gap:8vw}.results>div>p{color:#ffd96d}.numbers{border-top:1px solid rgba(255,255,255,.4);display:grid;grid-template-columns:repeat(3,1fr);margin-top:90px}.numbers div{border-right:1px solid rgba(255,255,255,.4);padding:20px 20px 42px 0}.numbers div+div{padding-left:20px}.numbers div:last-child{border:0}.numbers b{display:block;font-size:clamp(60px,8vw,130px);font-weight:500;letter-spacing:-.1em;line-height:.8}.numbers span{display:block;font-size:13px;line-height:1.3;margin-top:23px;max-width:130px}.results>.copy{margin:105px 0 0 42%;max-width:820px}.results .copy p:last-child{color:#ffd7cb}@media(max-width:800px){.bueno header{padding-bottom:54px}.meta{grid-template-columns:1fr auto}.meta span:last-child{display:none}.intro,.research,.proof__head,.digital,.results>div:first-child{grid-template-columns:1fr;gap:34px}.intro{padding-top:50px}.intro h1{font-size:clamp(65px,21vw,125px)}.hero{height:52vw;min-height:280px}.research,.proof,.digital,.results{padding-top:84px;padding-bottom:84px}.copy{grid-template-columns:1fr}.research__wide{margin-top:20px}.proof>.copy,.results>.copy{margin:55px 0}.proof__art{grid-template-columns:1fr 1fr}.proof__art figure:first-child{margin-top:45px}.digital>figure:not(.shellfies){margin-top:20px}.digital>.copy{grid-column:auto}.shellfies{margin-top:20px}.numbers{grid-template-columns:1fr;margin-top:54px}.numbers div,.numbers div+div{border-bottom:1px solid rgba(255,255,255,.4);border-right:0;padding:20px 0 30px}}.proof__head>p,.proof>.copy p:last-child{color:#593b20}

