---
interface Props { showCTA?: boolean; }
const { showCTA = true } = Astro.props;
const pages = [['/','INDEX'],['/info','INFO'],['/cases','CASES'],['/contact','CONTACT']];
const currentYear = new Date().getFullYear();
---

<footer class:list={["masthead-footer", {"masthead-footer--no-cta": !showCTA}]} role="contentinfo" aria-label="Studio footer">
  <div class="masthead-footer__mark masthead-footer__mark--opening"><img src="/logo.svg?v=charcoal" alt="Chrowm" width="200" height="34.54" /></div>
  <div class="masthead-footer__body">
    {showCTA && <div class="masthead-footer__invitation">
      <h2><a href="/contact">Let's start<br />something bold<span class="masthead-footer__arrow" aria-hidden="true">↗</span></a></h2>
      <p>CHROWM<sup>®</sup> — An independent design studio,<br class="desktop-break" /> based in Central Florida.</p>
    </div>}
    <nav class="masthead-footer__navigation" aria-label="Footer navigation">
      {pages.map(([href,label]) => <a href={href}><span>{label}</span><span class="masthead-footer__link-arrow" aria-hidden="true">↗</span></a>)}
    </nav>
    <div class="masthead-footer__contact">
      <a href="mailto:chile@chrowmdesigns.com">CHILE@CHROWMDESIGNS.COM</a>
      <p>CENTRAL FLORIDA STUDIO</p>
    </div>
    <nav class="masthead-footer__social" aria-label="Social profiles">
      <a href="https://www.linkedin.com/in/angelomanzano/" target="_blank" rel="noopener noreferrer">LINKEDIN<span aria-hidden="true">↗</span><span class="masthead-footer__sr"> (opens in a new tab)</span></a>
      <a href="https://www.behance.net/angelomanzanojr" target="_blank" rel="noopener noreferrer">BEHANCE<span aria-hidden="true">↗</span><span class="masthead-footer__sr"> (opens in a new tab)</span></a>
    </nav>
  </div>
  <div class="masthead-footer__legal"><span>©{currentYear}</span><button type="button" class="masthead-footer__preferences" data-analytics-settings hidden>Analytics settings</button><span>COPYRIGHT CHROWMDESIGNS. ALL RIGHTS RESERVED</span></div>
</footer>

<style>
  .masthead-footer__legal{flex-wrap:wrap}
  .masthead-footer__preferences[hidden]{display:none}
  .masthead-footer__preferences{font:inherit;text-transform:uppercase;color:inherit;background:none;border:0;padding:0;min-height:44px;cursor:pointer;text-decoration:underline;text-underline-offset:3px}
  .masthead-footer__preferences:focus-visible{outline:2px solid #1b1b1b;outline-offset:4px}
  .masthead-footer a:focus-visible{outline:2px solid var(--footer-ink);outline-offset:5px}
  .masthead-footer{--footer-white:#fff;--footer-ink:#1b1b1b;--footer-gray:#595959;--footer-rule:#d6d6d6;--footer-wash:#ededed;--footer-gutter:clamp(20px,3.4vw,56px);--footer-space:clamp(40px,5vw,80px);--footer-mono:'JetBrains Mono',monospace;--footer-sans:'Manrope',sans-serif;color:var(--footer-ink);background:var(--footer-white);font-style:normal}

  .masthead-footer{padding:var(--footer-space) var(--footer-gutter) 16px;isolation:isolate}
  .masthead-footer a{color:var(--footer-ink);text-decoration:none;min-height:44px;display:flex;align-items:center;scroll-margin-block:100px 24px}
  .masthead-footer a:hover{color:var(--footer-gray)}
  .masthead-footer h2,.masthead-footer p{margin:0}
  .masthead-footer h2{font:600 clamp(40px,4.7vw,72px)/1.05 var(--footer-sans);letter-spacing:-.055em}
  .masthead-footer h2 a{display:block;width:fit-content}
  .masthead-footer__arrow{display:inline-block;font-size:.65em;vertical-align:top;line-height:1.4;margin-left:.2em;transition:transform 180ms ease}
  .masthead-footer h2 a:hover .masthead-footer__arrow{transform:translate(3px,-3px)}
  .masthead-footer__invitation p{margin-top:24px;font:400 clamp(14px,1.2vw,18px)/1.5 var(--footer-sans);color:var(--footer-gray)}
  .masthead-footer sup{font-size:.6em}
  .masthead-footer__body{display:grid;gap:40px 6%;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  .masthead-footer__navigation{font:400 14px/1.4 var(--footer-mono)}
  .masthead-footer__navigation a{justify-content:space-between;gap:16px}
  .masthead-footer__navigation a:hover span:first-child,.masthead-footer__social a:hover,.masthead-footer__contact a:hover{text-decoration:underline;text-underline-offset:5px}
  .masthead-footer__contact,.masthead-footer__social,.masthead-footer__legal{font:400 12px/1.6 var(--footer-mono);letter-spacing:.015em}
  .masthead-footer__contact a{width:fit-content;overflow-wrap:anywhere;max-width:100%}
  .masthead-footer__contact p{color:var(--footer-gray)}
  .masthead-footer__social{display:flex;gap:32px;align-items:start}
  .masthead-footer__social a{gap:16px;width:fit-content}
  .masthead-footer__mark img{display:block;width:100%;height:auto;filter:grayscale(1);max-width:none}
  .masthead-footer__legal{display:flex;gap:24px;justify-content:space-between;align-items:start;border-top:1px solid var(--footer-rule);padding-top:16px;color:var(--footer-gray)}
  .masthead-footer__sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}

  /* Masthead: the wordmark introduces the entire footer; navigation becomes a horizontal index. */
  .masthead-footer{padding-top:40px}
  .masthead-footer .masthead-footer__mark{margin-bottom:var(--footer-space)}
  .masthead-footer .masthead-footer__body{grid-template-areas:'invitation navigation' 'contact social';padding-block:40px;border-top:1px solid var(--footer-rule);column-gap:8%}
  .masthead-footer .masthead-footer__invitation{grid-area:invitation}.masthead-footer .masthead-footer__navigation{grid-area:navigation;display:grid;grid-template-columns:1fr 1fr;gap:0 32px;align-content:start}.masthead-footer .masthead-footer__contact{grid-area:contact}.masthead-footer .masthead-footer__social{grid-area:social;align-self:end}
  .masthead-footer .masthead-footer__navigation a{font:500 clamp(24px,2.4vw,36px)/1.25 var(--footer-sans);letter-spacing:-.04em;border-bottom:1px solid var(--footer-rule);padding-block:16px}
  .masthead-footer .masthead-footer__link-arrow{font-size:.6em}

  @media(max-width:900px){

    .masthead-footer .masthead-footer__body{column-gap:5%}

  }
  @media(max-width:600px){

    .masthead-footer h2{font-size:clamp(36px,8.6vw,48px)}
    .masthead-footer__invitation p{margin-top:20px}.desktop-break{display:none}

    .masthead-footer .masthead-footer__body{grid-template-columns:1fr;grid-template-areas:'invitation' 'navigation' 'contact' 'social';gap:24px;padding-block:32px}
    .masthead-footer .masthead-footer__mark{margin-bottom:32px}

    .masthead-footer__legal{gap:16px;font-size:10px;padding-right:64px}.masthead-footer__legal span:last-child{max-width:27ch;text-align:right}
  }
  @media(prefers-reduced-motion:reduce){.masthead-footer__arrow{transition:none}.masthead-footer h2 a:hover .masthead-footer__arrow{transform:none}}
  .masthead-footer--no-cta .masthead-footer__body{grid-template-areas:"navigation contact" "navigation social"}
  @media(max-width:600px){.masthead-footer--no-cta .masthead-footer__body{grid-template-areas:"navigation" "contact" "social"}}
.masthead-footer h2 a{overflow-wrap:anywhere}
</style>
