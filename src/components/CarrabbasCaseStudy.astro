display:grid;gap:16px;grid-template-columns:1fr 1fr}.reading__images figure:first-child{grid-column:1/-1}.reading__images figure:first-child img{aspect-ratio:1.8}.reading__images figure:not(:first-child) img{aspect-ratio:.72}.warmth{background:#ded5c5;padding:4vw}.warmth figure{height:min(50vw,760px)}.warmth>div{align-self:end}.outcome{background:var(--green);color:#f5f2e9;padding:130px 4vw 0}.outcome .eyebrow{color:#c4e64d}.stats{border-top:1px solid #66915b;display:grid;grid-template-columns:repeat(3,1fr);margin-top:80px}.stats div{border-right:1px solid #66915b;padding:18px 18px 42px 0}.stats div+div{padding-left:18px}.stats b{display:block;font-size:clamp(42px,6vw,90px);font-weight:500;letter-spacing:-.08em;line-height:.8}.stats span{display:block;font-size:13px;line-height:1.35;margin-top:18px;max-width:120px}.outcome figure{align-self:end}.outcome figure img{aspect-ratio:1.78}@media(max-width:760px){.intro,.opening,.blueprint,.reading,.warmth,.outcome{grid-template-columns:1fr;gap:34px}.intro{padding-top:48px}.opening,.reading,.outcome{padding-top:82px;padding-bottom:82px}.blueprint>div figure{width:65%}.stats{grid-template-columns:1fr;margin-top:48px}.stats div,.stats div+div{border-bottom:1px solid #66915b;border-right:0;padding:18px 0 26px}.outcome figure{margin-bottom:-82px}.reading__images figure:first-child img{aspect-ratio:1.35}}
