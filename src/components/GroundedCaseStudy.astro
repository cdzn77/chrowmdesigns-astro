{aspect-ratio:1.46}.research__art figure:nth-child(2){aspect-ratio:.72;margin-bottom:6vw}.research__art figure:last-child{aspect-ratio:2.02}.language{background:var(--sage);padding:144px 4vw}.language__head{padding-bottom:90px}.language__head>p{color:#153d3a}.language h2{color:#103b38}.language__grid{display:grid;grid-template-columns:1.1fr .48fr .48fr .48fr;gap:20px;align-items:end}.language__copy{align-self:start;display:grid;gap:28px;font-size:clamp(18px,1.65vw,25px);letter-spacing:-.025em;line-height:1.34;max-width:550px}.language__copy p:last-child{font-size:16px;line-height:1.5}.portrait{aspect-ratio:.72}.portrait--explorer{margin-top:80px}.portrait--julia{margin-bottom:90px}.architecture{padding:144px 4vw 0}.architecture__title{display:grid;grid-template-columns:.75fr 1.25fr;gap:8vw;margin-bottom:86px}.architecture figure{background:var(--sage);padding:5vw 3vw}.architecture figure img{aspect-ratio:1.78;object-fit:contain}.architecture__copy{margin-bottom:0;padding-bottom:140px}.results{background:var(--deep);color:#eef8f4;padding:136px 4vw}.results>div:first-child{display:grid;grid-template-columns:1fr 1.25fr;gap:8vw}.results>div>p{color:#a4d7ca}.results__facts{border-top:1px solid rgba(236,248,244,.32);display:grid;grid-template-columns:repeat(3,1fr);margin-top:90px}.results__facts div{border-right:1px solid rgba(236,248,244,.32);padding:22px 20px 38px 0}.results__facts div+div{padding-left:20px}.results__facts div:last-child{border:0}.results__facts strong{display:block;font-size:clamp(58px,8vw,130px);font-weight:500;letter-spacing:-.1em;line-height:.8}.results__facts span{display:block;font-size:13px;line-height:1.3;margin-top:22px;max-width:125px}.results__copy{color:#eef8f4;margin-bottom:0;padding-top:108px}.results__copy p:last-child{color:#b4d2ca}@media(max-width:800px){.intro{padding-bottom:54px}.meta{grid-template-columns:1fr auto}.meta span:last-child{display:none}.intro__grid,.section-heading,.language__head,.architecture__title,.results>div:first-child{grid-template-columns:1fr;gap:34px;padding-top:0}.intro__grid{padding-top:50px}.intro h1{font-size:clamp(68px,21vw,125px)}.hero{height:52vw;min-height:280px}.research,.language,.architecture,.results{padding-top:84px;padding-bottom:84px}.research__copy,.architecture__copy,.results__copy{grid-template-columns:1fr;margin:54px 0}.research__art{grid-template-columns:1fr 1fr}.research__art figure:last-child{grid-column:span 2}.research__art figure:nth-child(2){margin-bottom:0}.language__head{padding-bottom:54px}.language__grid{grid-template-columns:1fr 1fr}.language__copy{grid-column:span 2;margin-bottom:26px}.portrait--explorer,.portrait--julia{margin:0}.portrait--bear{grid-column:span 2;aspect-ratio:1.45}.architecture figure{margin:0 -4vw;padding:9vw 4vw}.architecture__copy{padding-bottom:0}.results__facts{grid-template-columns:1fr;margin-top:54px}.results__facts div,.results__facts div+div{border-bottom:1px solid rgba(236,248,244,.32);border-right:0;padding:20px 0 30px}.results__copy{padding-top:0}}

  .lede,.language__copy,.language__copy p:last-child{font-size:clamp(16px,1.3vw,17px);line-height:1.65;letter-spacing:normal}
