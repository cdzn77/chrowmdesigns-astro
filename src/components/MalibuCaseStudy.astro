sation .index{color:#fff0a8}.sensation h2{margin-bottom:80px}.sensation .copy{color:#effffc;max-width:680px}.sensation .copy p:last-child{color:#bcf0e8}.sensation figure:first-of-type{align-self:end;margin-bottom:7vw}.sensation figure:last-of-type{align-self:start}.sensation figure:first-of-type img{aspect-ratio:.72}.sensation figure:last-of-type img{aspect-ratio:1.78}.toolkit{background:var(--yellow)}.toolkit__title{display:grid;grid-template-columns:1fr 1.3fr;gap:8vw;margin-bottom:85px}.toolkit__images{display:grid;grid-template-columns:.72fr .55fr;gap:20px;align-items:start;margin-left:20%;max-width:1000px}.toolkit__images figure:first-child{margin-top:90px}.toolkit__images img{aspect-ratio:.72}.toolkit>.copy{margin:88px 0 0 42%;max-width:850px}.results{background:var(--orange);color:#fff;padding:140px 4vw}.results .index{color:#fff1b5}.results>div:first-child{display:grid;grid-template-columns:1fr 1.3fr;gap:8vw}.numbers{border-top:1px solid rgba(255,255,255,.4);display:grid;grid-template-columns:repeat(3,1fr);margin-top:92px}.numbers div{border-right:1px solid rgba(255,255,255,.4);padding:20px 20px 42px 0}.numbers div+div{padding-left:20px}.numbers div:last-child{border:0}.numbers b{display:block;font-size:clamp(60px,8vw,130px);font-weight:500;letter-spacing:-.1em;line-height:.8}.numbers span{display:block;font-size:13px;line-height:1.3;margin-top:23px;max-width:120px}.results>.copy{margin:105px 0 0 42%;max-width:820px}.results .copy p:last-child{color:#ffe0bc}@media(max-width:800px){.intro{padding-bottom:54px}.meta{grid-template-columns:1fr auto}.meta span:last-child{display:none}.intro__grid,.audit,.sensation,.toolkit__title,.results>div:first-child{grid-template-columns:1fr;gap:34px}.intro__grid{padding-top:50px}.intro h1{font-size:clamp(64px,20vw,120px)}.hero{height:52vw;min-height:280px}.audit,.sensation,.toolkit,.results{padding-top:84px;padding-bottom:84px}.copy{grid-template-columns:1fr}.audit__art{grid-template-columns:1fr 1fr;margin-top:20px}.audit__art img:last-child{margin:45px 0 -20px}.sensation h2{margin-bottom:50px}.sensation figure:first-of-type{margin:0}.toolkit__images{margin:0;grid-template-columns:1fr 1fr}.toolkit__images figure:first-child{margin-top:45px}.toolkit>.copy,.results>.copy{margin:55px 0 0}.numbers{grid-template-columns:1fr;margin-top:54px}.numbers div,.numbers div+div{border-bottom:1px solid rgba(255,255,255,.4);border-right:0;padding:20px 0 30px}}

.index{color:#b3410a}
.sensation,.sensation .index,.sensation h2 .heading-accent,.sensation .copy,.sensation .copy p:last-child{color:#052d2c}
