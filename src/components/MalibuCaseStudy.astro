t img:last-child{margin:45px 0 -20px}.sensation h2{margin-bottom:50px}.sensation figure:first-of-type{margin:0}.toolkit__images{margin:0;grid-template-columns:1fr 1fr}.toolkit__images figure:first-child{margin-top:45px}.toolkit>.copy,.results>.copy{margin:55px 0 0}.numbers{grid-template-columns:1fr;margin-top:54px}.numbers div,.numbers div+div{border-bottom:1px solid rgba(255,255,255,.4);border-right:0;padding:20px 0 30px}}

