mn:span 2}.research__images figure:nth-child(2){margin-bottom:0}.architecture>.copy,.results>.copy{margin:55px 0}.implementation__images{grid-template-columns:1fr 1fr;margin-top:20px}.implementation__images figure:first-child{margin-bottom:0}.implementation>.copy{grid-column:auto}.numbers{grid-template-columns:1fr;margin-top:54px}.numbers div,.numbers div+div{border-bottom:1px solid rgba(9,47,64,.35);border-right:0;padding:20px 0 30px}}.disney :global(*){min-width:0}.disney :is(h1,h2,p){overflow-wrap:anywhere}
