---
// Existing studio inquiry endpoint.
const FORMSPREE_ID = 'xzdlzplo';
const action = `https://formspree.io/f/${FORMSPREE_ID}`;
// Public site key only. The secret belongs in Formspree's CAPTCHA settings.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || '0x4AAAAAAEulPu3wmfVT0G7O';

const budgetOptions = [
  { value: '',                label: 'Select a range…' },
  { value: 'under-5k',        label: 'Under $5,000' },
  { value: '5k-15k',          label: '$5,000 – $15,000' },
  { value: '15k-30k',         label: '$15,000 – $30,000' },
  { value: '30k-50k',         label: '$30,000 – $50,000' },
  { value: '50k-plus',        label: '$50,000+' },
  { value: 'lets-discuss',    label: "Let's Discuss" },
];

const subjectOptions = [
  { value: '',              label: 'Select a subject…' },
  { value: 'ux-design',     label: 'UX Design' },
  { value: 'brand-strategy',label: 'Brand Strategy' },
  { value: 'campaign',      label: 'Campaign Design' },
  { value: 'consulting',    label: 'Consulting' },
  { value: 'general',       label: 'General Inquiry' },
];
---

<form
  id="contact-form"
  class="contact-form"
  action={action}
  method="POST"
  aria-label="Contact form"
  data-turnstile-site-key={turnstileSiteKey}
>
  <!-- Formspree honeypot — leave empty, bots fill it -->
  <input type="text" name="_gotcha" class="contact-form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <!-- Row 1: Full Name + Email -->
  <div class="contact-form__row">
    <div class="contact-form__field">
      <label class="contact-form__label" for="cf-name">
        Full Name <span class="contact-form__req" aria-hidden="true">*</span>
      </label>
      <input
        class="contact-form__input"
        type="text"
        id="cf-name"
        name="name"
        maxlength="120"
        autocomplete="name"
        required
        aria-required="true"
      />
      <span class="contact-form__error" id="cf-name-error" hidden></span>
    </div>
    <div class="contact-form__field">
      <label class="contact-form__label" for="cf-email">
        Email Address <span class="contact-form__req" aria-hidden="true">*</span>
      </label>
      <input
        class="contact-form__input"
        type="email"
        id="cf-email"
        name="email"
        maxlength="254"
        autocomplete="email"
        required
        aria-required="true"
      />
      <span class="contact-form__error" id="cf-email-error" hidden></span>
    </div>
  </div>

  <!-- Row 2: Phone + Company -->
  <div class="contact-form__row">
    <div class="contact-form__field">
      <label class="contact-form__label" for="cf-phone">Phone Number</label>
      <input
        class="contact-form__input"
        type="tel"
        id="cf-phone"
        name="phone"
        maxlength="50"
        autocomplete="tel"
      />
      <span class="contact-form__error" id="cf-phone-error" hidden></span>
    </div>
    <div class="contact-form__field">
      <label class="contact-form__label" for="cf-company">Company Name</label>
      <input
        class="contact-form__input"
        type="text"
        id="cf-company"
        name="company"
        maxlength="160"
        autocomplete="organization"
      />
      <span class="contact-form__error" id="cf-company-error" hidden></span>
    </div>
  </div>

  <!-- Row 3: Budget + Subject -->
  <div class="contact-form__row">
    <div class="contact-form__field">
      <label class="contact-form__label" for="cf-budget">Project Budget</label>
      <div class="contact-form__select-wrap">
        <select class="contact-form__select" id="cf-budget" name="budget">
          {budgetOptions.map(({ value, label }) => (
            <option value={value}>{label}</option>
          ))}
        </select>
        <span class="contact-form__select-arrow" aria-hidden="true">
          <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
    </div>
    <div class="contact-form__field">
      <label class="contact-form__label" for="cf-subject">Subject</label>
      <div class="contact-form__select-wrap">
        <select class="contact-form__select" id="cf-subject" name="subject">
          {subjectOptions.map(({ value, label }) => (
            <option value={value}>{label}</option>
          ))}
        </select>
        <span class="contact-form__select-arrow" aria-hidden="true">
          <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
    </div>
  </div>

  <!-- Message -->
  <div class="contact-form__field contact-form__field--full">
    <label class="contact-form__label" for="cf-message">
      Your Message <span class="contact-form__req" aria-hidden="true">*</span>
    </label>
    <textarea
      class="contact-form__textarea"
      id="cf-message"
      name="message"
      maxlength="10000"
      rows="6"
      required
      aria-required="true"
    ></textarea>
      <span class="contact-form__error" id="cf-message-error" hidden></span>
  </div>

  {turnstileSiteKey && (
    <div class="contact-form__verification">
      <div id="cf-verification"></div>
      <noscript><p>JavaScript is needed for the security check. You can also <a href="mailto:chile@chrowmdesigns.com">email me directly</a>.</p></noscript>
    </div>
  )}

  <!-- Submit -->
  <div class="contact-form__footer">
    <p class="contact-form__note">
      Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.
    </p>
    <button class="contact-form__submit" type="submit" id="cf-submit">
      <span class="contact-form__submit-text">Send Message</span>
      <span class="contact-form__submit-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 8H14M14 8L8 2M14 8L8 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </button>
  </div>

  <!-- Status messages (shown via JS) -->
  <div class="contact-form__status" id="cf-status" role="status" aria-live="polite" hidden></div>
</form>

<style>
  .contact-form__honeypot {
    display: none !important;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Two-column rows */
  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  /* Labels */
  .contact-form__label {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #666666;
    cursor: pointer;
    font-family: JetBrains Mono, monospace;
  }

  .contact-form__req {
    color: #1b1b1b;
    margin-left: 0.15em;
  }

  /* Inputs + textarea */
  .contact-form__input,
  .contact-form__textarea,
  .contact-form__select {
    width: 100%;
    background-color: #f5f5f5;
    border: 1px solid #767676;
    border-radius: 0;
    color: #1b1b1b;
    font-family: JetBrains Mono, monospace;
    font-size: 12px;
    line-height: 1.5;
    transition: border-color 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
  }

  .contact-form__input:hover,
  .contact-form__textarea:hover,
  .contact-form__select:hover {
    border-color: #666666;
    background-color: #ffffff;
  }

  .contact-form__input:focus,
  .contact-form__textarea:focus,
  .contact-form__select:focus {
    border-color: #1b1b1b;
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(27, 27, 27, 0.3);
  }

  .contact-form__input,
  .contact-form__select {
    height: 48px;
    padding: 0 1rem;
  }

  .contact-form__textarea {
    padding: 0.875rem 1rem;
    resize: vertical;
    min-height: 140px;
  }

  .contact-form__input:focus,
  .contact-form__textarea:focus,
  .contact-form__select:focus {
    border-color: #1b1b1b;
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(27, 27, 27, 0.3);
  }

  /* Errors are shown only after validation. */
  .contact-form__input[aria-invalid="true"],
  .contact-form__textarea[aria-invalid="true"] {
    border-color: var(--color-error);
  }

  /* Select wrapper (custom arrow) */
  .contact-form__select-wrap {
    position: relative;
  }

  .contact-form__select {
    cursor: pointer;
    padding-right: 2.5rem;
  }

  /* Style the select options */
  .contact-form__select option {
    background-color: #ffffff;
    color: #1b1b1b;
  }

  .contact-form__select-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-secondary);
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  /* Footer row */
  .contact-form__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .contact-form__note {
    font-size: 12px;
    color: var(--color-secondary);
    margin: 0;
    font-family: JetBrains Mono, monospace;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  /* Submit button */
  .contact-form__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 2rem;
    font-family: JetBrains Mono, monospace;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #ffffff;
    background-color: #1b1b1b;
    border: 1px solid #1b1b1b;
    border-radius: 0;
    cursor: pointer;
    transition: background-color, color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    white-space: nowrap;
  }

  .contact-form__submit:hover:not(:disabled) {
    background-color: transparent;
    color: #1b1b1b;
    border-color: #1b1b1b;
    transform: none;
    gap: 0.6rem;
    box-shadow: none;
  }

  .contact-form__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  /* Status message */
  .contact-form__status {
    padding: 1rem 1.25rem;
    border-radius: 0;
    font-size: 12px;
    line-height: 1.5;
    font-family: JetBrains Mono, monospace;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .contact-form__status :global(a) { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

  .contact-form__status--success {
    background-color: #eef5f0;
    border: 1px solid #b5cdbd;
    color: #216447;
  }

  .contact-form__status--error {
    background-color: rgba(255, 80, 80, 0.08);
    border: 1px solid rgba(255, 80, 80, 0.25);
    color: var(--color-error);
  }

  @media (max-width: 560px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }
  }
  .contact-form__input, .contact-form__textarea, .contact-form__select {
    font-family: var(--font-sans); font-size: var(--font-size-md);
  }
  .contact-form__error { font-size: var(--font-size-sm); color: var(--color-error); line-height: 1.5; }
  .contact-form__error[hidden] { display: none; }
  .contact-form__status { font-family: var(--font-sans); font-size: var(--font-size-md); text-transform: none; }
</style>

<script>
  type TurnstileApi = {
    render: (container: HTMLElement, options: Record<string, unknown>) => string;
    reset: (id: string) => void;
    remove: (id: string) => void;
    getResponse: (id: string) => string;
  };
  const turnstileWindow = window as Window & { turnstile?: TurnstileApi };
  let turnstileLoad: Promise<TurnstileApi> | undefined;
  function loadTurnstile(): Promise<TurnstileApi> {
    if (turnstileWindow.turnstile) return Promise.resolve(turnstileWindow.turnstile);
    if (turnstileLoad) return turnstileLoad;
    turnstileLoad = new Promise<TurnstileApi>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      const timer = window.setTimeout(() => fail(), 15000);
      function fail() {
        window.clearTimeout(timer);
        script.remove();
        reject(new Error('verification-unavailable'));
      }
      script.onload = () => {
        window.clearTimeout(timer);
        if (turnstileWindow.turnstile) resolve(turnstileWindow.turnstile);
        else fail();
      };
      script.onerror = fail;
      document.head.append(script);
    }).catch(error => { turnstileLoad = undefined; throw error; });
    return turnstileLoad;
  }
  let cleanupForm: (() => void) | undefined;
  function initContactForm() {
    cleanupForm?.();
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submit = document.getElementById('cf-submit') as HTMLButtonElement | null;
    const status = document.getElementById('cf-status');
    if (!form || !submit || !status) return;
    const controller = new AbortController();
    const { signal } = controller;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([name="_gotcha"]):not([type="hidden"]), textarea')];
    const siteKey = form.dataset.turnstileSiteKey;
    let widgetId: string | undefined;
    let verificationLoading = false;
    let attempted = false;
    form.noValidate = true;
    function validate(field: HTMLInputElement | HTMLTextAreaElement) {
      const error = document.getElementById(field.id + '-error');
      field.setCustomValidity(field.required && !field.value.trim() ? 'Please complete this field.' : field.maxLength > 0 && field.value.length > field.maxLength ? `Please use ${field.maxLength} characters or fewer.` : '');
      const invalid = !field.validity.valid;
      field.setAttribute('aria-invalid', String(invalid));
      if (error) {
        error.hidden = !invalid;
        error.textContent = invalid ? (field.validity.valueMissing || (field.required && !field.value.trim()) ? 'Please complete this field.' : field.type === 'email' ? 'Enter a valid email address, such as name@example.com.' : field.validationMessage) : '';
        if (invalid) field.setAttribute('aria-describedby', error.id);
        else field.removeAttribute('aria-describedby');
      }
      return !invalid;
    }
    fields.forEach(field => {
      field.addEventListener('blur', () => { if (attempted || field.value) validate(field); }, { signal });
      field.addEventListener('input', () => { if (attempted || field.hasAttribute('aria-invalid')) validate(field); }, { signal });
    });
    function showStatus(message: string, type: 'success' | 'error', emailFallback = false) {
      status!.textContent = message;
      if (emailFallback) {
        const email = document.createElement('a');
        email.href = 'mailto:chile@chrowmdesigns.com';
        email.textContent = 'email me directly';
        status!.append(' ', email, '.');
      }
      status!.className = 'contact-form__status contact-form__status--' + type;
      status!.hidden = false;
    }
    async function initVerification() {
      if (!siteKey || verificationLoading || widgetId !== undefined) return;
      const container = document.getElementById('cf-verification');
      if (!container) return;
      verificationLoading = true;
      form!.dataset.verificationState = 'pending';
      try {
        const api = await loadTurnstile();
        if (signal.aborted) return;
        widgetId = api.render(container, {
          sitekey: siteKey,
          theme: 'light',
          size: 'compact',
          appearance: 'interaction-only',
          action: 'contact',
          callback: () => { form!.dataset.verificationState = 'ready'; },
          'expired-callback': () => { form!.dataset.verificationState = 'expired'; },
          'error-callback': (code: string) => {
            form!.dataset.verificationState = 'error';
            form!.dataset.verificationError = code;
            showStatus('The security check could not finish. Try again or', 'error', true);
          },
          'timeout-callback': () => {
            form!.dataset.verificationState = 'expired';
            showStatus('The security check timed out. Try again or', 'error', true);
          },
        });
      } catch {
        if (!signal.aborted) showStatus('The security check could not load. Try again or', 'error', true);
      } finally {
        verificationLoading = false;
      }
    }
    void initVerification();
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (submit.disabled) return;
      fields.forEach(field => { field.value = field.value.trim(); });
      attempted = true;
      const valid = fields.map(validate).every(Boolean);
      if (!valid) {
        showStatus('Please check the highlighted fields before sending.', 'error');
        fields.find(field => !field.validity.valid)?.focus();
        return;
      }
      // UX gate only: Formspree must require and verify the token server-side.
      if (siteKey && (widgetId === undefined || !turnstileWindow.turnstile?.getResponse(widgetId))) {
        showStatus('The security check is still pending. Give it a moment, then try again, or', 'error', true);
        if (widgetId === undefined) void initVerification();
        else turnstileWindow.turnstile?.reset(widgetId);
        return;
      }
      submit.disabled = true;
      form.setAttribute('aria-busy', 'true');
      const label = submit.querySelector('.contact-form__submit-text');
      if (label) label.textContent = 'Sending…';
      status.hidden = true;
      const request = new AbortController();
      const abortRequest = () => request.abort();
      signal.addEventListener('abort', abortRequest, { once: true });
      const timer = window.setTimeout(() => request.abort(), 30000);
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' }, signal: request.signal });
        if (response.status === 429) throw new Error('rate-limit');
        if (!response.ok) throw new Error('delivery');
        const result = await response.json();
        if (result.ok !== true) throw new Error('delivery');
        form.reset();
        attempted = false;
        fields.forEach(field => { field.removeAttribute('aria-invalid'); field.removeAttribute('aria-describedby'); });
        showStatus("Message sent — I'll be in touch soon.", 'success');
      } catch (error) {
        if (signal.aborted) return;
        const message = request.signal.aborted ? 'Delivery could not be confirmed before the connection timed out. Your details are still here. Check before resending, or' : error instanceof Error && error.message === 'rate-limit' ? 'The form is receiving too many requests. Your details are still here. Please wait a few minutes or' : 'Your message could not be sent. Your details are still here. Try again or';
        showStatus(message, 'error', true);
      } finally {
        window.clearTimeout(timer);
        signal.removeEventListener('abort', abortRequest);
        if (!signal.aborted && widgetId !== undefined) turnstileWindow.turnstile?.reset(widgetId);
        if (!signal.aborted) {
          submit.disabled = false;
          form.removeAttribute('aria-busy');
          if (label) label.textContent = 'Send Message';
        }
      }
    }, { signal });
    cleanupForm = () => {
      controller.abort();
      if (widgetId !== undefined) turnstileWindow.turnstile?.remove(widgetId);
    };
  }
  document.addEventListener('astro:page-load', initContactForm);
  document.addEventListener('astro:before-swap', () => cleanupForm?.());
</script>
